# ProofLine — Environment Configuration
# Copy this to .env (or backend/.env) and fill in your values.

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://proofline:proofline@localhost:5432/proofline
TEST_DATABASE_URL=postgresql+psycopg://proofline:proofline@localhost:5432/proofline_test

# ── Authentication & Security ────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60

# ── AI / LLM Configuration ────────────────────────────────────────────────────
LLM_API_KEY=your-api-key-here
LLM_MODEL=gemini-pro
MOCK_AI=true

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
